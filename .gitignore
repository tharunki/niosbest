# Never publish secrets, local student records, or generated uploads.
# Keep any documented example file explicit and credential-free; every actual
# environment file is local-only, including production variants.
.env
.env.*
!.env.example
.envrc
*.pem
*.p12
*.pfx
*.key
service-account*.json
firebase-adminsdk*.json
outputs/portal-service/.env
outputs/portal-service/.env.*
!outputs/portal-service/.env.example
# The service and QA checks create state directories with several suffixes.
outputs/portal-service/.portal-data*/
outputs/portal-service/qa/test-results/
outputs/portal-service/qa/playwright-report/
outputs/portal-service/*.log
*.log
.DS_Store

# Local editor and temporary files.
.vscode/
.idea/
tmp/
