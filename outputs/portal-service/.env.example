# Local preview
PORT=3000
NODE_ENV=development
ALLOW_DEMO_ACCOUNTS=true
APP_PUBLIC_URL=http://localhost:3000
PORTAL_STATE_DIR=

# Required in production; keep both values server-only
APP_ENCRYPTION_KEY=
ADMIN_API_TOKEN=
# On the first production start, use one of the two protected owner emails.
# Invite the second owner securely from /admin/staff after signing in.
BOOTSTRAP_ADMIN_EMAIL=niosbest.tvl@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=

# NIOS status workflow: manual | official | mock (development only)
NIOS_SYNC_MODE=manual
SYNC_INTERVAL_MINUTES=15
OFFICIAL_NIOS_CONNECTOR_URL=
OFFICIAL_NIOS_CONNECTOR_TOKEN=

# Private document storage: local | supabase | s3
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_BUCKET=student-documents
SUPABASE_SERVICE_ROLE_KEY=
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Payments: razorpay for live payments; mock for local testing only
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email intake and student notification delivery
RESEND_API_KEY=
ADMIN_ADMISSION_EMAIL=
ADMISSION_EMAIL_FROM=
ADMISSION_INTAKE_WEBHOOK_URL=
NOTIFICATION_PROVIDER=mock

# Zoom Server-to-Server OAuth (optional automatic meeting creation)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_TIMEZONE=Asia/Kolkata

# Optional SMS / WhatsApp providers
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WATI_SEND_URL=
WATI_TOKEN=
WEBHOOK_URL=
