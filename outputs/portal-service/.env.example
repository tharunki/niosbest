# Local preview
PORT=3000
NODE_ENV=development
ALLOW_DEMO_ACCOUNTS=true
APP_PUBLIC_URL=http://localhost:3000
PORTAL_STATE_DIR=
# Durable application state: "local" is for development and automated tests
# only. Production blocks all mutating APIs until this is "supabase".
PORTAL_STATE_DRIVER=local
SUPABASE_STATE_SCHEMA=public
SUPABASE_STATE_TABLE=portal_state
SUPABASE_STATE_ROW_ID=primary

# Required in production; keep both values server-only
APP_ENCRYPTION_KEY=
ADMIN_API_TOKEN=
# On the first production start, use one of the two protected owner emails.
# Invite the second owner securely from /admin/staff after signing in.
BOOTSTRAP_ADMIN_EMAIL=niosbest.tvl@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=
# Emergency recovery only: create a fresh 32-byte token (43-character
# base64url or 64 hexadecimal characters), bind it to one protected owner,
# and expire it within 24 hours. Remove all three after one successful reset.
ADMIN_ACCOUNT_RECOVERY_EMAIL=
ADMIN_ACCOUNT_RECOVERY_TOKEN=
ADMIN_ACCOUNT_RECOVERY_EXPIRES_AT=

# NIOS status workflow: manual | official | mock (development only)
NIOS_SYNC_MODE=manual
SYNC_INTERVAL_MINUTES=15
OFFICIAL_NIOS_CONNECTOR_URL=
OFFICIAL_NIOS_CONNECTOR_TOKEN=

# Private document storage: local | supabase | s3
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_BUCKET=student-documents
SUPABASE_SERVICE_ROLE_KEY=
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
# Set true only when a trusted reverse proxy strips client-supplied forwarded
# headers and supplies the correct source address for rate limiting.
TRUST_PROXY=false

# Payments: razorpay for live payments; mock for local testing only
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email intake and student notification delivery
# Sending key: server-only, restricted to the verified academy sender/domain.
RESEND_API_KEY=
# Optional server-only key with permission to read the Resend Domains API.
# If blank, RESEND_API_KEY is used for the safe read-only readiness check.
RESEND_READINESS_API_KEY=
ADMIN_ADMISSION_EMAIL=
# Required for admin intake, staff invitations, and student notifications.
# Production never falls back to Resend's onboarding sender.
ADMISSION_EMAIL_FROM=
ADMISSION_INTAKE_WEBHOOK_URL=
NOTIFICATION_PROVIDER=mock
# New student accounts must prove control of their email before sign-in.
# Optional. If blank, the verified admission sender above sends OTPs too.
# When set, its sender domain is checked independently from the admission
# sender. Production remains closed when the OTP sender is unverified or
# unreachable; no code is returned by the API.
EMAIL_VERIFICATION_FROM=
EMAIL_VERIFICATION_TEST_MODE=false
# Test-only switch used by QA to simulate a provider outage. Never set this
# outside isolated local tests.
EMAIL_VERIFICATION_TEST_DELIVERY_FAILURE=false
# Real email/SMS/WhatsApp/webhook delivery is disabled outside production by
# default, even if this machine has production credentials in `.env`. Set true
# only for a controlled development-provider test.
ALLOW_DEVELOPMENT_OUTBOUND_DELIVERY=false

# Zoom Server-to-Server OAuth (optional automatic meeting creation)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Licensed Zoom host email address or Zoom user ID. Required only when the
# portal creates meetings automatically; a pasted HTTPS meeting link works without it.
ZOOM_HOST_USER_ID=
ZOOM_TIMEZONE=Asia/Kolkata

# Optional SMS / WhatsApp providers
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WATI_SEND_URL=
WATI_TOKEN=
WEBHOOK_URL=
