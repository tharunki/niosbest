{
  // A browseable catalogue/admin preview used only while the private R2 bucket
  // is awaiting activation. It intentionally omits the PAPERS binding.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "best-education",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/admin.html", "/library.html", "/api/*", "/paper/*", "/sitemap.xml", "/robots.txt", "/healthz", "/sample-papers.html", "/pyqs.html", "/mcqs.html", "/important-questions.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "best-education-db",
      "database_id": "859b8aa4-b6f7-4863-ac57-510e0f027d4c",
      "migrations_dir": "./cloudflare/migrations"
    }
  ]
}
