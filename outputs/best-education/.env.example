ADMIN_PASSWORD=replace-with-a-long-private-password
DOWNLOAD_TOKEN_SECRET=use-a-different-random-secret-of-at-least-32-characters
SITE_URL=https://tksolutions.in
PORT=4173
# Leave blank locally. On Render set this to /var/data (the persistent disk).
STORAGE_DIR=
# Add both values to activate Razorpay checkout and verified timed downloads.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Configure this in Razorpay for payment.captured and payment.failed webhooks.
RAZORPAY_WEBHOOK_SECRET=
# Keep sales closed until an end-to-end secure-payment test has passed. Set to
# true only on the Worker environment that is ready to accept purchases.
PAYMENTS_ENABLED=false
