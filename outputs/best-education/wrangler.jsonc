{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "best-education",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/paper/*", "/sitemap.xml", "/robots.txt", "/healthz"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "best-education-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "./cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PAPERS",
      "bucket_name": "best-education-papers"
    }
  ]
}
