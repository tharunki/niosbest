{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "best-education",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    // 09:00 Asia/Kolkata (03:30 UTC) every day: prunes expired anonymous
    // records and redacts expired unpaid checkout details promptly.
    "crons": ["30 3 * * *"]
  },
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/index", "/admin", "/library", "/privacy", "/terms", "/sample-papers", "/pyqs", "/mcqs", "/important-questions", "/index.html", "/admin.html", "/library.html", "/privacy.html", "/terms.html", "/api/*", "/paper/*", "/collection/*", "/sitemap.xml", "/robots.txt", "/healthz", "/sample-papers.html", "/pyqs.html", "/mcqs.html", "/important-questions.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "best-education-db",
      "database_id": "859b8aa4-b6f7-4863-ac57-510e0f027d4c",
      "migrations_dir": "./cloudflare/migrations"
    }
  ]
}
